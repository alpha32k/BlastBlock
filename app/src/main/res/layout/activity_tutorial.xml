<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tutorial_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/bb_screen_padding"
        android:text="@string/tutorial_title"
        android:textColor="@color/bb_amber"
        android:textSize="@dimen/bb_text_score"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tutorial_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:paddingHorizontal="@dimen/bb_screen_padding"
        android:text="@string/tutorial_instruction"
        android:textColor="@color/bb_text_primary"
        android:textSize="@dimen/bb_text_button" />

    <com.blastblock.game.presentation.ui.GameView
        android:id="@+id/tutorial_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/tutorial_instruction" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tutorial_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/bb_screen_padding"
        android:background="@drawable/ui_button_secondary"
        android:minHeight="@dimen/bb_button_height"
        android:text="@string/tutorial_skip"
        android:textAllCaps="false"
        android:textColor="@color/bb_text_primary"
        android:textSize="@dimen/bb_text_button" />
</LinearLayout>
