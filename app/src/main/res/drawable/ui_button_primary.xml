<?xml version="1.0" encoding="utf-8"?>
<!-- Birincil düğme ("Yeni Oyun", "Tekrar Oyna"): dolu neon turkuaz, yuvarlak köşe.
     Basılıyken zemin yarı saydam turkuaza döner; koyu arka plan üzerinde koyulaşmış görünür. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bb_preview_valid" />
            <stroke android:width="2dp" android:color="@color/bb_turquoise" />
            <corners android:radius="@dimen/bb_button_corner" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bb_board_line" />
            <corners android:radius="@dimen/bb_button_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bb_turquoise" />
            <corners android:radius="@dimen/bb_button_corner" />
        </shape>
    </item>
</selector>
